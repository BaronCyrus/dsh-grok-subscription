{
  "name": "dsh-grok-subscription",
  "version": "2.0.5",
  "description": "Use a SuperGrok or X Premium Grok Build subscription in DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs/assets",
    "docs/guide.zh-CN.md",
    "docs/guide.en.md",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "grok-build",
    "supergrok",
    "subscription",
    "oauth"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.1.5-rc.2 <0.3.0-0",
    "@earendil-works/pi-ai": "0.82.1 || 0.85.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5"
  },
  "author": "BaronCyrus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaronCyrus/dsh-grok-subscription.git"
  },
  "bugs": {
    "url": "https://github.com/BaronCyrus/dsh-grok-subscription/issues"
  },
  "homepage": "https://github.com/BaronCyrus/dsh-grok-subscription#readme",
  "publishConfig": {
    "access": "public"
  }
}
